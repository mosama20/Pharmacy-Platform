# ==============================================================================
# Chefaa Healthcare Platform — Production Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD@localhost:5432/chefaa_db?schema=public"

# Authentication & Security
# WARNING: JWT_SECRET MUST be at least 32 characters long. The backend will refuse to boot if less than 32 chars.
JWT_SECRET="replace_with_a_cryptographically_secure_random_string_at_least_32_characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Security (Comma-separated origins, NO trailing slashes)
CORS_ORIGIN="https://chefaa.com,https://admin.chefaa.com,http://localhost:5173"
ALLOWED_ORIGINS="https://chefaa.com,https://admin.chefaa.com"

# Rate Limiting & Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
